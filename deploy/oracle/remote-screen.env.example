# /etc/remote-screen.env — biến môi trường cho server trên máy Oracle.
# setup.sh tạo file này lần đầu (quyền 600). Sửa xong: sudo systemctl restart remote-screen

PORT=8080
# Không dùng TURN dựng sẵn trong Node: máy này đã có coturn.
LOCAL_TURN=0
# Máy luôn bật, không cần tự ping chống ngủ như Render.
KEEP_AWAKE=0

# coturn trên CHÍNH máy này (điền IP công khai + tài khoản trong /etc/turnserver.conf)
SG_TURN_URLS=turn:PUBLIC_IP:3478?transport=udp,turn:PUBLIC_IP:3478?transport=tcp
SG_TURN_USER=
SG_TURN_PASS=
SG_TURN_NAME=Singapore
# Server chung máy với coturn: chỉ thử STUN (xem server.js). Kiểm tra đầy đủ từ ngoài bằng check-turn.js.
SG_TURN_PROBE=stun

# Chép từ Render (Environment) sang nếu đang dùng:
CF_TURN_KEY_ID=
CF_TURN_TOKEN=
# JSON service account Firebase trên MỘT dòng (đánh thức qua FCM + lưu presence vào RTDB)
FIREBASE_SERVICE_ACCOUNT=
